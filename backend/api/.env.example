APP_NAME="WhatsApp CRM API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=structured
LOG_STACK=structured
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=whatsapp_crm
DB_USERNAME=whatsapp_crm
DB_PASSWORD=change_me

SESSION_DRIVER=redis
SESSION_LIFETIME=45
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@whatsapp-crm.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=change_me
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=whatsapp-crm
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
SESSION_ENCRYPTION_KEY=
SERVICE_TO_SERVICE_SECRET=

SENTRY_DSN=

WHATSAPP_SYNC_INTERNAL_BASE_URL=http://localhost:3100
WHATSAPP_SYNC_WEBHOOK_SECRET=
WHATSAPP_SYNC_DEFAULT_WORKSPACE_SLUG=demo
