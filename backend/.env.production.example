APP_NAME="CRM WhatsApp"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<your-backend-app>.onrender.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@alphahgcrm.com
MAIL_FROM_NAME="CRM WhatsApp"

SANCTUM_STATEFUL_DOMAINS=
FRONTEND_URL=https://<your-frontend-app>.onrender.com
WHATSAPP_COUNTRY_CODE=94
WHATSAPP_GATEWAY_URL=https://<your-gateway-app>.onrender.com
WHATSAPP_GATEWAY_TOKEN=
WHATSAPP_GATEWAY_TIMEOUT=10
INTERNAL_SHARED_SECRET=

# Supabase Storage (S3-compatible API)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=whatsapp-media
AWS_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true
