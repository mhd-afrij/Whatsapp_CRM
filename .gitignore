# Root repository ignores
# NOTE: repo directories are `backend/`/`frontend/` (lowercase) on disk, but
# legacy `Backend/`/`Frontend/` paths are still tracked. Patterns below match
# at any depth and are case-insensitive on Windows, so they cover both.

# Dependencies (Cline/IDE indexing: exclude these in the tool's settings too)
node_modules/
vendor/

# Build / generated output
dist/
build/
coverage/
.next/
out/
.venv/

# Laravel runtime artifacts (git keeps the dirs via their own .gitignore)
storage/logs/
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
bootstrap/cache/*.php

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
