# =========================================================================
# CRM-WhatsApp — root environment reference
# Copy to .env for docker-compose. Each service also keeps its own
# .env.example (backend/.env.example, frontend/.env.example,
# whatsapp-gateway/.env.example) for local (non-docker) development.
# =========================================================================

# ---- General ----
APP_ENV=local
NODE_ENV=development

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=rootsecret
DB_DATABASE=crm_whatsapp
DB_USERNAME=crm_user
DB_PASSWORD=crm_password
DB_HOST=mysql
DB_PORT=3306

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Backend (Laravel) ----
APP_NAME="CRM WhatsApp"
APP_KEY=
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost
QUEUE_CONNECTION=redis
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="CRM WhatsApp"
WHATSAPP_COUNTRY_CODE=94

# ---- WhatsApp Gateway ----
PORT=4000
MYSQL_HOST=mysql
LARAVEL_INTERNAL_API_URL=http://backend:8000/api/internal
INTERNAL_SHARED_SECRET=change-me-shared-secret
SOCKET_CORS_ORIGIN=http://localhost:3000
WHATSAPP_SESSION_DIR=/app/sessions
LOG_LEVEL=info

# Shared secret used by the backend to authenticate against the gateway's
# /internal/whatsapp/* routes (backend: WHATSAPP_GATEWAY_TOKEN;
# gateway: INTERNAL_GATEWAY_TOKEN). Must be identical on both services.
WHATSAPP_GATEWAY_TOKEN=change-me-to-a-long-random-secret
INTERNAL_GATEWAY_TOKEN=change-me-to-a-long-random-secret
# 32-byte key as hex, e.g. `openssl rand -hex 32` - encrypts persisted Baileys
# auth credentials. MUST be overridden with a real random value in any
# environment that isn't a throwaway local sandbox.
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WHATSAPP_WORKSPACE_ID=1

# ---- Gateway media storage (Azure Blob Storage) ----
# 'local' (default) or 'azure'. When 'azure', provide a connection string OR
# account key below; AZURE_STORAGE_URL is the account base URL.
STORAGE_PROVIDER=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=whatsapp-media
AZURE_STORAGE_URL=https://<account>.blob.core.windows.net

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_COUNTRY_CODE=94
