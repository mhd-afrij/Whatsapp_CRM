# =========================================================================
# CRM-WhatsApp — root environment reference (Supabase + Render)
# =========================================================================

# ---- General ----
APP_ENV=local
NODE_ENV=development

# ---- Supabase PostgreSQL Database ----
DB_CONNECTION=pgsql
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-supabase-db-password

# ---- Backend (Laravel) ----
APP_NAME="CRM WhatsApp"
APP_KEY=
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
MAIL_MAILER=log
WHATSAPP_COUNTRY_CODE=94

# ---- WhatsApp Gateway ----
PORT=4000
LARAVEL_INTERNAL_API_URL=http://backend:8000/api/internal
INTERNAL_SHARED_SECRET=change-me-shared-secret
SOCKET_CORS_ORIGIN=http://localhost:3000
WHATSAPP_SESSION_DIR=/app/sessions
LOG_LEVEL=info

# Shared secret used by backend and gateway
WHATSAPP_GATEWAY_URL=http://whatsapp-gateway:4000
WHATSAPP_GATEWAY_TOKEN=change-me-to-a-long-random-secret
INTERNAL_GATEWAY_TOKEN=change-me-to-a-long-random-secret

# 32-byte key as hex (`openssl rand -hex 32`) to encrypt WhatsApp session credentials in PostgreSQL
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WHATSAPP_WORKSPACE_ID=1

# ---- Supabase Object Storage (whatsapp-media bucket) ----
# Gateway: uses @supabase/supabase-js
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=whatsapp-media

# Backend: uses Flysystem S3-compatible driver for Supabase Storage
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=your-supabase-storage-access-key-id
AWS_SECRET_ACCESS_KEY=your-supabase-storage-secret-access-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=whatsapp-media
AWS_ENDPOINT=https://<your-project-ref>.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_COUNTRY_CODE=94
