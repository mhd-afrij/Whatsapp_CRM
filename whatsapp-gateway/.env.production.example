NODE_ENV=production
PORT=4000

# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
PGHOST=db.<project-ref>.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
PGSSL=true

LARAVEL_INTERNAL_API_URL=https://<your-backend-app>.onrender.com/api/internal
INTERNAL_SHARED_SECRET=
SOCKET_CORS_ORIGIN=https://<your-frontend-app>.onrender.com
WHATSAPP_SESSION_DIR=./sessions
INTERNAL_GATEWAY_TOKEN=
CREDENTIALS_ENCRYPTION_KEY=
WHATSAPP_WORKSPACE_ID=1
STARTUP_RESTORE_CONCURRENCY=3
SESSION_LOCK_ENABLED=false
GATEWAY_INSTANCE_ID=render-gateway
SESSION_LEASE_MS=30000
SESSION_HEARTBEAT_INTERVAL_MS=10000
WHATSAPP_COUNTRY_CODE=94
LOG_LEVEL=info
MEDIA_MAX_SIZE_BYTES=26214400
MEDIA_LOCAL_STORAGE_DIR=./media-storage
STORAGE_PROVIDER=supabase

# Supabase Storage
SUPABASE_STORAGE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=whatsapp-media

MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/3gpp,audio/ogg,audio/mpeg,audio/mp4,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
