PORT=4000
NODE_ENV=development

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_USERNAME=
REDIS_PASSWORD=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=crm_whatsapp
MYSQL_USER=root
MYSQL_PASSWORD=

LARAVEL_INTERNAL_API_URL=http://localhost:8000/api/internal
INTERNAL_SHARED_SECRET=change-me-to-a-long-random-secret

SOCKET_CORS_ORIGIN=http://localhost:3000
WHATSAPP_SESSION_DIR=./sessions

INTERNAL_GATEWAY_TOKEN=change-me-to-a-long-random-secret
# 32-byte key as hex, e.g. `openssl rand -hex 32`
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WHATSAPP_WORKSPACE_ID=1

# Session lock (workspace_sync_assignments). Leave disabled for a single
# gateway instance; enable only when two gateway replicas can race for the
# same workspace's WhatsApp session.
SESSION_LOCK_ENABLED=false
# GATEWAY_INSTANCE_ID=<hostname>:<port> by default - override for a stable id
SESSION_LEASE_MS=30000
SESSION_HEARTBEAT_INTERVAL_MS=10000

WHATSAPP_KEEPALIVE_INTERVAL_MS=
WHATSAPP_COUNTRY_CODE=94

LOG_LEVEL=info

# Media handling
MEDIA_MAX_SIZE_BYTES=26214400
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/3gpp,audio/ogg,audio/mpeg,audio/mp4,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
MEDIA_LOCAL_STORAGE_DIR=./media-storage

# Optional MinIO/S3-compatible object storage.
# If S3_BUCKET is unset, the gateway falls back to local-disk storage.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Outbound send rate limiting
# SEND_RATE_LIMIT_MAX=1
# SEND_RATE_LIMIT_DURATION_MS=1000
